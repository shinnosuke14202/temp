openssl genrsa -out bob.key 2048

openssl req -new -key bob.key -out bob.csr -subj "/CN=bob/O=dev"

cat bob.csr | base64 | tr -d "\n"

apiVersion: certificates.k8s.io/v1
kind: CertificateSigningRequest
metadata:
  name: bob
spec:
  request: <base64-...>
  signerName: kubernetes.io/kube-apiserver-client
  expirationSeconds: 86400
  usages:
  - client auth

kubectl apply -f csr.yaml

kubectl get certificatesigningrequest

kubectl certificate approve alice bob

kubectl get csr bob -o jsonpath='{.status.certificate}' | base64 -d > bob.crt

kubectl config set-context bob --cluster minikube --user bob

kubectl config set-credentials bob --client-key $(realpath
 bob.key) --client-certificate $(realpath bob.crt)

kubectl config use-context minikube

apiVersion: rbac.authorization.k8s.io/v1
kind: Role
metadata:
  name: pod-reader
  namespace: dev
rules:
- apiGroups: [""]
  resources: ["pods"]
  verbs: ["get", "list"]

kubectl apply -f dev-pod-reader.yaml

kubectl get role -n dev

